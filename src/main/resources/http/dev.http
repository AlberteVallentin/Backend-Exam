### Configuration
@contentType = application/json

### User Management

### Register user
POST {{url}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Test User",
  "email": "test@user.dk",
  "password": "test123",
  "roleType": "USER"
}

### Login user and set jwt_token
POST {{url}}/auth/login
Content-Type: {{contentType}}

{
  "email": "test@user.dk",
  "password": "test123"
}

> {% client.global.set("jwt_token", response.body.token); %}


### Register user that becomes admin
POST {{url}}/auth/register
Content-Type: {{contentType}}

{
  "name": "Test Admin",
  "email": "test@admin.dk",
  "password": "test123",
  "roleType": "USER"
}



### Add admin role to user
POST {{url}}/auth/user/addrole
Content-Type: application/json
Authorization: Bearer {{jwt_token}}

{
  "role": "ADMIN"
}


### Login admin
POST {{url}}/auth/login
Content-Type: {{contentType}}

{
  "email": "test@admin.dk",
  "password": "test123"
}

> {% client.global.set("jwt_token", response.body.token); %}

### Trip Endpoints - Public Access

### Get all trips
GET {{url}}/trips
Accept: {{contentType}}

### Get specific trip
GET {{url}}/trips/1
Accept: {{contentType}}

### Trip Endpoints - User Access (requires jwt_token)


### Create new trip
POST {{url}}/trips
Content-Type: {{contentType}}
Authorization: Bearer {{jwt_token}}

{
  "name": "Copenhagen City Walk",
  "startTime": "2024-11-05T10:00:00.000Z",
  "endTime": "2024-11-05T12:00:00.000Z",
  "longitude": 12.5683,
  "latitude": 55.6761,
  "price": 299.99,
  "category": "CITY"
}

### Update existing trip
PUT {{url}}/trips/1
Content-Type: {{contentType}}
Authorization: Bearer {{jwt_token}}

{
  "name": "Updated Copenhagen City Walk",
  "startTime": "2024-11-05T10:00:00.000Z",
  "endTime": "2024-11-05T12:00:00.000Z",
  "longitude": 12.5683,
  "latitude": 55.6761,
  "price": 349.99,
  "category": "CITY"
}

### Add guide to trip
PUT {{url}}/trips/1/guides/1
Authorization: Bearer {{jwt_token}}

### Delete trip (requires admin login first)
DELETE {{url}}/trips/1
Authorization: Bearer {{jwt_token}}

### Populate database (requires admin login first)
POST {{url}}/trips/populate
Authorization: Bearer {{jwt_token}}

### Error Testing

### Test invalid trip creation (should fail validation)
POST {{url}}/trips
Content-Type: {{contentType}}
Authorization: Bearer {{jwt_token}}

{
  "name": "",
  "price": -100
}

### Test get non-existent trip
GET {{url}}/trips/999
Accept: {{contentType}}

### Test unauthorized access (no token)
POST {{url}}/trips
Content-Type: {{contentType}}

{
  "name": "Unauthorized Trip",
  "startTime": "2024-11-05T10:00:00.000Z",
  "endTime": "2024-11-05T12:00:00.000Z",
  "longitude": 12.5683,
  "latitude": 55.6761,
  "price": 299.99,
  "category": "CITY"
}


### Reset token (if needed)
GET {{url}}/auth/test

> {%
    client.global.set("jwt_token", null);
    client.log("JWT Token reset");
%}